# ── 运行时数据（含用户 DB/令牌/音频产物/上传/日志/模型权重/临时截图，绝不入仓）──
var/
var-test/

# ── Python 执行环境（uv 独立 venv，重建命令见 README 快速开始 2b）──
venv/
venv-*/
__pycache__/
*.pyc

# ── 构建产物 ──
builds/
*.apk
*.aab
*.ap_
*.symbols

# ── 签名密钥（口令与 keystore 位置在本地 android/key.properties，绝不入仓）──
*.jks
*.keystore
src/app/android/key.properties
src/app/android/local.properties

# ── Flutter/Dart ──
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
doc/api/
app.*.symbols
app.*.map.json

# ── Android/IDE ──
src/app/android/.gradle/
src/app/android/app/build/
src/app/android/app/debug/
src/app/android/app/profile/
src/app/android/app/release/
src/app/android/.cxx/
.idea/
*.iml
*.ipr
*.iws
.vscode/

# ── 验收自带 ffmpeg 二进制（能力探测目录，只留 .gitkeep）──
test/acceptance/tools/ffmpeg/*
!test/acceptance/tools/ffmpeg/.gitkeep

# ── 杂项 ──
*.log
.DS_Store
Thumbs.db
.env
.env.*
node_modules/

# ── 真机开发实例数据（用户 DB、真机录音 uploads/、250MB 音频产物，绝不入仓）──
# 启动脚本不在此目录入库；ASR worker 启动脚本见 scripts/start-asr.ps1
var-real/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# ── Agent 工作区/临时产物（worktree 副本、远程同步中转包，绝不入仓）──
.qoder/worktrees/
tmp/

# ── 本机服务实例产物（2026-11-26 抢救补：与实态对齐，防「项目本体」被运行时垃圾淹没）──
run/
*.pid
services/*/out/
services/*/.cache/
services/*/*.log
src/app/android/app/.cxx/
deploy/spark/evidence/

# ── 本机运行时符号链接（bin/*.sh 用 $BASE/node/bin/node，绝不入仓）──
/node

# ── 本机私密配置（口令/token 只在此，绝不入仓；样例见 deploy/spark/spark.env.example）──
etc/*.env
!etc/*.env.example
# ── vendored 引擎依赖（190G 级模型/venv/上游仓，绝不入仓；部署时另行拉取）──
services/*/venv/
services/*/models/
services/*/*-repo/
services/*/.cache/

# ── 本机 ACE-Step 运行接线（指向仓外权重/venv 的符号链接，换机即失效，绝不入仓）──
# 注意：它们是**符号链接**，上面的 venv/ 目录型规则匹配不到，必须逐条显式忽略
services/acestep/venv
services/acestep/models
services/acestep/acestep-repo
services/acestep/.cache/
