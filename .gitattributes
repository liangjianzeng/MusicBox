# 文本统一按 LF 入库；Windows 检出时脚本必须保持 LF（否则 gradlew/sh 不可执行）
* text=auto
*.sh    text eol=lf
*.py    text eol=lf
gradlew text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.ico binary
*.jar binary
*.wav binary
*.mp3 binary
*.ttf binary
*.apk binary
*.aab binary

# 引擎入口收编件：必须逐字节保真（Windows CRLF），不许 git 归一化
vendor/acestep/*.py -text
vendor/acestep/*.orig -text
