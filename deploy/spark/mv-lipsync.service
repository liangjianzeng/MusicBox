# mv-lipsync（Spark 运行单元）—— EchoMimicV3-Flash 兼容口型重绘 :8390（2026-11-25）
# 已实现外部运行时适配；启用前需配置 MB_LIPSYNC_COMMAND 并完成 venv/权重与宿主协调。
# 单推理锁；83xx 段仅回环监听，不对宿主外网暴露。
[Unit]
Description=MusicBox MV Lipsync Service (EchoMimicV3-Flash, :8390)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=musicbox
Group=musicbox
WorkingDirectory=/opt/musicbox/src/workers/mv_lipsync
ExecStart=/opt/musicbox/var/venv-lipsync/bin/uvicorn app:app --host 127.0.0.1 --port 8390
Environment=MODELSCOPE_CACHE=/opt/musicbox/var/models
EnvironmentFile=-/etc/musicbox/spark.env
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/musicbox/var
PrivateTmp=true
MemoryHigh=14G
MemoryMax=16G

[Install]
WantedBy=multi-user.target
