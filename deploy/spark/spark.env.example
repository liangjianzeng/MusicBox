# /etc/musicbox/spark.env 模板（2026-11-24）—— Spark 五单元共用 EnvironmentFile（deploy/spark/*.service）
# 草案纪律：本阶段只交付模板，禁止真机写入/systemctl（宿主协调 S6）。
# 机密（MB_EXECUTOR_TOKEN 等）落地后 chmod 600，勿入仓。
# 端口纪律（架构 §1.1/§1.2）：83xx 仅回环；:8188/:8090 为剧场共宿主服务——只发请求、只读观测，
# 代码层无 /free；MB_COMFY_URL 一键切换逃生口 :8288（仅 SP-MV-4 互扰超标启用）。

# —— API 与执行器身份 ——
MB_API_URL=http://127.0.0.1:7900
MB_EXECUTOR_TOKEN=<executorToken>
MB_LANES=imgspark,vidspark,lipsync,align,ffmpeg

# —— 共宿主 ComfyUI（剧场 :8188，只读观测+提交；逃生口 :8288） ——
MB_COMFY_URL=http://127.0.0.1:8188

# —— MusicBox 自有 worker 段（83xx，executor 独占调用） ——
MB_LIPSYNC_URL=http://127.0.0.1:8390
MB_FACEGATE_URL=http://127.0.0.1:8395
MB_MV_ASR_URL=http://127.0.0.1:8391

# —— 一期既有端点（同机保持） ——
MB_MUSIC_URL=http://127.0.0.1:8190
MB_ASR_URL=http://127.0.0.1:8191

# —— 公共与 LLM ——
# MB_PUBLIC_BASE_URL 必须是客户端可达地址（局域网/Tailscale IP；留 127.0.0.1 真机播放全挂，一期实测）
MB_PUBLIC_BASE_URL=http://<spark-lan-ip>:7900
# 剧场托管 vLLM（只读复用，零改动；模型名以 /models 返回为准）
MB_LLM_VLM_URL=http://127.0.0.1:8090/v1
MB_LLM_VLM_MODEL=qwen38-fp4

# —— 运行时目录与工具 ——
MB_VAR_DIR=/opt/musicbox/var
MB_FFMPEG=ffmpeg
MB_FFPROBE=ffprobe
# compose/preview 叠层 drawtext 字体（可选；留空走 fontconfig 默认。中文字幕建议显式指定，如：）
# MB_MV_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
