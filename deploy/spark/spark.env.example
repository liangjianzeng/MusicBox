# ~/MusicBox/etc/spark.env 模板（2026-11-25）—— DGX 单机全后端共用（bin/start_*.sh 与 systemd 单元同源）
# 口径变更：所有后端服务与部署物料在 /home/jianzengliang/MusicBox；5060 Ti 只知识/调测历史，不生产依赖。
# 机密（MB_EXECUTOR_TOKEN 等）落地后 chmod 600，勿入仓。
# 端口纪律（架构 §1.1/§1.2）：83xx 仅回环；:8188 共宿主队列——只发任务+只读观测，代码层无 /free；
# MB_COMFY_URL 一键切换逃生口 :8288（仅互扰超标启用）。

# —— API 与执行器身份 ——
MB_API_URL=http://127.0.0.1:7900
MB_EXECUTOR_TOKEN=<executorToken>
MB_LANES=music,intent,ffmpeg,imgspark,vidspark,lipsync,align

# —— 共宿主生图/生视频队列（:8188） ——
MB_COMFY_URL=http://127.0.0.1:8188

# —— MusicBox 自有 worker 段（83xx，executor 独占调用） ——
MB_LIPSYNC_URL=http://127.0.0.1:8390
MB_FACEGATE_URL=http://127.0.0.1:8395
MB_MV_ASR_URL=http://127.0.0.1:8391
MB_LIPSYNC_MODELS=/home/jianzengliang/MusicBox/var/models
MB_FACEGATE_MODELS=/home/jianzengliang/MusicBox/var/models/facegate
# facegate 即 insightface(buffalo_l) 落 MODEL_ROOT/models/buffalo_l/*.onnx；ref 照路径即 ROOTS 白名单（落位必落，否则 400）
MB_FACEGATE_MODEL_NAME=buffalo_l
MB_FACEGATE_ROOTS=/home/jianzengliang/MusicBox/var

# —— 生乐与一期转写端点（同机） ——
MB_MUSIC_URL=http://127.0.0.1:8190
MB_ASR_URL=http://127.0.0.1:8191
MB_SENSEVOICE_URL=http://127.0.0.1:8191

# —— 公共与 LLM ——
# MB_PUBLIC_BASE_URL 必须客户端可达（DGX 网实值 192.168.1.10；留 127.0.0.1 则真机播放全挂）
MB_PUBLIC_BASE_URL=http://192.168.1.10:7900
MB_LLM_VLM_URL=http://127.0.0.1:8090/v1
MB_LLM_VLM_MODEL=qwen38-fp4

# —— 灰度开关（二期 MV 线 / 音乐助手） ——
MB_MV_ENABLED=1
MB_MUSIC_ASSISTANT=1
# MB_MV_ASSISTANT_CHAT / MB_MUSIC_ASSISTANT_CHAT 缺 0（对话版灰度，文本多模换装后开）

# —— 运行时目录与工具 ——
MB_VAR_ROOT=/home/jianzengliang/MusicBox/var
MB_VAR_DIR=/home/jianzengliang/MusicBox/var
MB_FFMPEG=ffmpeg
MB_FFPROBE=ffprobe
# MB_MV_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# 开发档固定验证码（客户端测试链路用；生产必 MB_DEV_OTP=0）
MB_DEV_OTP=1
