# mv-facegate（Spark 草案）—— ArcFace 身份门控 :8395（2026-11-24）
# 草案纪律：本阶段禁止 systemctl enable/run（insightface onnx venv 属 N0-4，宿主协调 S4/S6）。
# CPU 常驻 ~2G；仅回环监听（架构 §1.2：83xx 段不对外）。
[Unit]
Description=MusicBox MV Facegate Service (insightface, :8395)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=musicbox
Group=musicbox
WorkingDirectory=/opt/musicbox/src/workers/mv_facegate
ExecStart=/opt/musicbox/var/venv-facegate/bin/uvicorn app:app --host 127.0.0.1 --port 8395
EnvironmentFile=-/etc/musicbox/spark.env
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/musicbox/var
PrivateTmp=true
MemoryHigh=3G
MemoryMax=4G

[Install]
WantedBy=multi-user.target
